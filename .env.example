# Environment Variables (Example)
# Copy this to .env.local and fill in real values.

# ── API Configuration ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# ── App Configuration ──────────────────────────────────────────────────────────
VITE_APP_NAME=Data Udipi

# ── Vapi Voice Agent (Customer-side) ──────────────────────────────────────────
# Public key — safe to expose in Vite (browser) bundle
VITE_VAPI_PUBLIC_KEY=

# Your pre-configured Vapi Assistant ID from the Vapi Dashboard
VITE_VAPI_ASSISTANT_ID=

# ── NOTE: VAPI_PRIVATE_KEY is NEVER placed here. ──────────────────────────────
# If backend Vapi management is ever required, add it only to the
# backend .env (Food_Ordering_App_Backend/.env) as:
#   VAPI_PRIVATE_KEY=
# Never prefix it with VITE_ — that would expose it to the browser.

# ── Gemini (Admin chatbot backend — DO NOT REMOVE — still used by admin MCP) ──
# These remain in the backend .env only. Listed here for documentation:
# GEMINI_API_KEY=       (backend only)
# GEMINI_MODEL=         (backend only)
